<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>PaletteShellExtension</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <WindowsSdkPackageVersion>10.0.26100.68-preview</WindowsSdkPackageVersion>
    <TargetFramework>net9.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>

    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    
    <AppxPackageIdentityName>phireForge.PaletteShell</AppxPackageIdentityName>
    <AppxPackagePublisher>phireForge</AppxPackagePublisher>
    <AppxPackageVersion>0.0.7.0</AppxPackageVersion>

    <!-- Shared self-signed cert for sideload testing (CN matches Publisher). Store re-signs on
         submission, so this is dev-only. Cert must live in CurrentUser\My on the build machine. -->
    <AppxPackageSigningEnabled>true</AppxPackageSigningEnabled>
    <PackageCertificateThumbprint>655B3250FBBF0E38A4B98C8F44B7DD5E9A9DEC56</PackageCertificateThumbprint>

    <!-- Trim the self-contained .NET runtime in Release so the packaged extension stays small.
         Clipboard uses native WinRT (see ClipboardHelper). The analyzer keeps future trim hazards
         visible at build time; the TrimmerRootAssembly entries below protect the
         COM/reflection-activated surface. -->
    <!-- Gate on Platform (a command-line global, set before this evaluates) rather than
         RuntimeIdentifier: the MSIX packaging build (dotnet build -p:Platform=x64/ARM64) only
         injects the RID in a later target, so a RID-only condition never fires on the ship path
         and the package ships untrimmed. The RID clause keeps `dotnet publish -r <rid>` trimming
         too. Plain builds/tests run as AnyCPU with no RID, so they skip trimming (which requires
         self-contained) and avoid NETSDK1102. -->
    <PublishTrimmed Condition="'$(Configuration)' == 'Release' and ('$(Platform)' == 'x64' or '$(Platform)' == 'ARM64' or '$(RuntimeIdentifier)' != '')">true</PublishTrimmed>
    <EnableTrimAnalyzer Condition="'$(PublishTrimmed)' == 'true'">true</EnableTrimAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\**\*.png" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PaletteShellExtension.Tests" />
  </ItemGroup>

  <!-- The extension is activated over COM, so root the whole app assembly to keep the
       COM-activated entry types the trimmer can't statically see. Add more entries here if
       EnableTrimAnalyzer flags stripped assemblies during publish. -->
  <ItemGroup>
    <TrimmerRootAssembly Include="PaletteShellExtension" />
  </ItemGroup>

  <Target Name="PrepareAssets" BeforeTargets="BeforeBuild">
    <!-- Copy scale-specific assets to base filenames expected by store validations -->
    <Copy SourceFiles="$(MSBuildProjectDirectory)\Assets\Square150x150Logo.scale-100.png" DestinationFiles="$(MSBuildProjectDirectory)\Assets\Square150x150Logo.png" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\Assets\SmallTile.scale-100.png" DestinationFiles="$(MSBuildProjectDirectory)\Assets\SmallTile.png" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\Assets\Wide310x150Logo.scale-100.png" DestinationFiles="$(MSBuildProjectDirectory)\Assets\Wide310x150Logo.png" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\Assets\SplashScreen.scale-100.png" DestinationFiles="$(MSBuildProjectDirectory)\Assets\SplashScreen.png" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\Assets\LargeTile.scale-100.png" DestinationFiles="$(MSBuildProjectDirectory)\Assets\LargeTile.png" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\Assets\StoreLogo.scale-100.png" DestinationFiles="$(MSBuildProjectDirectory)\Assets\StoreLogo.png" SkipUnchangedFiles="true" />
  </Target>
  
  <ItemGroup>
    <EmbeddedResource Include="SampleScripts\*.ps1" />
    <None Include="PaletteScriptAttributes.psm1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Agent-facing script authoring spec. Linked into the output as AGENTS.md so it ships
         next to the module and gets copied into the user's scripts folder. -->
    <None Include="..\docs\PaletteShellScripts.AGENTS.md" Link="AGENTS.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\docs\PaletteShellScripts.Reference.md" Link="PaletteShellScripts.Reference.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CommandPalette.Extensions" />
    <PackageReference Include="Microsoft.Windows.CsWinRT" />
    <PackageReference Include="Shmuelie.WinRTServer" />

    <!-- Needed to enable building an MSIX package -->
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.MSIX">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <PropertyGroup>
    <DefaultLanguage>en</DefaultLanguage>
    <Title>PaletteShell</Title>
  </PropertyGroup>


</Project>
